    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "mixins": [
    "simpletools.mixins.json"
  ],
  "suggests": {
    "simplebuilding": "*",
    "simplequalityoflife": "*",
    "modmenu": "*"
