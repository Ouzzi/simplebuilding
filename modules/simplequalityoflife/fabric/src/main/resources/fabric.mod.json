{
  "schemaVersion": 1,
  "id": "simplequalityoflife",
  "version": "${version}",
  "name": "Simple Quality of Life",
  "description": "Super-mod: bundles Simple Weather, Simple Interfaces, Simple Loot, Simple Mob Manners, Simple Farming, Simple Tools and Simple Movement with one switch each; guide book and start quest.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplequalityoflife.FabricExample"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplequalityoflife.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simplequalityoflife.QolModMenu"
    ]
  },
  "depends": {
    "simpleweather": "*",
    "simpleinterfaces": "*",
    "simplemovement": "*",
    "simpletools": "*",
    "simplefarming": "*",
    "simplemobmanners": "*",
    "simpleloot": "*",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "suggests": {
    "simplebuilding": "*",
    "modmenu": "*"
  }
}
