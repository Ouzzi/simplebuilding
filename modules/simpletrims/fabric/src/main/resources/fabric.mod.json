{
  "schemaVersion": 1,
  "id": "simpletrims",
  "version": "${version}",
  "name": "Simple Trims",
  "icon": "assets/simpletrims/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Glowing, Emitting and Pulsating armor trim templates, placeable trim templates and trim upgrades. Works on its own with the axe; SimpleBuilding adds the sledgehammer.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpletrims.TrimsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simpletrims.TrimsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpletrims.ModuleGameTest"
    ],
    "jei_mod_plugin": [
      "com.simpletrims.compat.TrimsJeiPlugin"
    ]
  },
  "mixins": [
    "simpletrims.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.3.0"
  },
  "suggests": {
    "jei": "*",
    "simplebuilding": "*"
  }
}
