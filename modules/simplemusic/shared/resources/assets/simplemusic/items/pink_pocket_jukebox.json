{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:bundle/has_selected_item",
          "on_true": {
            "type": "minecraft:composite",
            "models": [
              {
                "type": "minecraft:model",
                "model": "simplemusic:item/pink_pocket_jukebox_open_back"
              },
              {
                "type": "minecraft:bundle/selected_item"
              },
              {
                "type": "minecraft:model",
                "model": "simplemusic:item/pink_pocket_jukebox_open_front"
              }
            ]
          },
          "on_false": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "simplemusic:playing",
            "on_true": {
              "type": "minecraft:model",
              "model": "simplemusic:item/pink_pocket_jukebox_playing"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "simplemusic:item/pink_pocket_jukebox"
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "simplemusic:playing",
      "on_true": {
        "type": "minecraft:model",
        "model": "simplemusic:block/pink_pocket_jukebox_playing"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "simplemusic:block/pink_pocket_jukebox"
      }
    }
  }
}
