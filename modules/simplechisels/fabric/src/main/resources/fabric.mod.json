    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "LicenseRef-SimpleMods-ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplechisels.ChiselsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplechisels.ChiselsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplechisels.ModuleGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.3.0"
