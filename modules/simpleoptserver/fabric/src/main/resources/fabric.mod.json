{
  "schemaVersion": 1,
  "id": "simpleoptserver",
  "version": "${version}",
  "name": "Simple Opt Server",
  "icon": "assets/simpleoptserver/icon.png",
  "description": "Server optimizations of Simple Optimization: view distance follows server load (MSPT) within the server.properties bounds; optional activation range for far mobs (off by default); steps back when ServerCore is installed.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleoptserver.fabric.ServerOptFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleoptserver.ModuleGameTest"
    ]
  },
  "depends": {
    "simplelib": ">=0.3.0",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "simpleoptserver.mixins.json"
  ]
}
