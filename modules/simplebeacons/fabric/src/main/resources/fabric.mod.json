      "com.simplebuilding.modules.simplebeacons.BeaconsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplebeacons.ModuleGameTest"
    ]
  },
  "mixins": [
    "simplebeacons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.4.0-beta.1"
  },
  "recommends": {
    "simpleores": "*"
  },
  "suggests": {
    "simplebuilding": "*",
    "simplemobs": "*"
  }
