  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplebeacons.BeaconsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplebeacons.BeaconsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplebeacons.ModuleGameTest"
    ]
  },
  "mixins": [
    "simplebeacons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.2.0"
  },
  "suggests": {
    "simplebuilding": "*"
  }
}
