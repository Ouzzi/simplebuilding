  "jei.simpleores.info.dull_end_ores": [
   "Hides in the veins of Astralit and Nihilit Ore: about one ore block in five is dull. Looks alike but unrefined - a little softer, weaker glow - and needs a diamond pickaxe too. Drops dull dust or a dull shard (Silk Touch: the ore itself).",
   "Steckt in den Adern von Astralit- und Nihiliterz: etwa jeder fünfte Erzblock ist trüb. Sieht ähnlich aus, ist aber unraffiniert – etwas weicher, schwächerer Schein – und braucht ebenfalls eine Diamantspitzhacke. Lässt trüben Staub bzw. einen trüben Splitter fallen (Behutsamkeit: das Erz selbst)."
  ],
  "jei.simpleores.info.dull_end_drops": [
   "Unrefined End material from dull ore. Four of them craft one real Astralit Dust or Nihilit Shard.",
   "Unraffiniertes End-Material aus trübem Erz. Vier davon ergeben einen echten Astralitstaub bzw. Nihilitsplitter."
  ]
 },
 "config": {
  "endSignals": {
   "label": [
    "Astral/Nihil Redstone",
    "Astral-/Nihil-Redstone"
   ],
   "tip": [
    "Astral, Nihil and Bridge Redstone conduct.\nRecipes update on datapack reload. Default: true.",
    "Astral-, Nihil- und Brücken-Redstone leiten.\nRezepte nach Datenpaket-Neuladen. Standard: true."
   ]
  },
  "endPistons": {
   "label": [
    "End Pistons",
    "End-Kolben"
   ],
   "tip": [
    "Astral and Nihil pistons move blocks.\nRecipes update on datapack reload.\nDefault: true.",
    "Astral- und Nihil-Kolben bewegen Blöcke.\nRezepte nach Datenpaket-Neuladen.\nStandard: true."
   ]
  },
  "endRails": {
   "label": [
    "End Rails",
    "End-Schienen"
   ],
   "tip": [
    "Astral rails boost and Nihil rails brake.\nOff: they act as plain rails. Recipes\nupdate on datapack reload. Default: true.",
    "Astral-Schienen beschleunigen, Nihil-Schienen\nbremsen. Aus: normale Schienen. Rezepte nach\nDatenpaket-Neuladen. Standard: true."
   ]
  },
  "endPistonCooldownTicks": {
   "label": [
    "End Piston Cooldown (4–100)",
    "End-Kolben-Abklingzeit (4–100)"
   ],
   "tip": [
    "Ticks a piston waits after firing,\nlimited to 4-100. Default: 8.",
    "Ticks Wartezeit nach dem Auslösen,\nbegrenzt auf 4-100. Standard: 8."
   ]
  },
  "astralRailMaxSpeed": {
   "label": [
    "Astral Rail Top Speed (8–20)",
    "Astral-Schiene Höchsttempo (8–20)"
   ],
   "tip": [
    "Blocks per second on flat Astral rails,\nlimited to 8-20 (vanilla 8). Default: 16.",
    "Blöcke pro Sekunde auf flachen Astral-Schienen,\nbegrenzt auf 8-20 (Vanilla 8). Standard: 16."
   ]
  },
  "astralRailBoost": {
   "label": [
    "Astral Rail Boost (0.07–0.25)",
    "Astral-Schiene Schub (0,07–0,25)"
   ],
   "tip": [
    "Push per tick at standstill, shrinking\nwith (speed/top speed)². Powered rail: 0.06.\nDefault: 0.12.",
    "Schub je Tick aus dem Stand, sinkt mit\n(Tempo/Höchsttempo)². Antriebsschiene: 0,06.\nStandard: 0,12."
   ]
  },
  "nihilRailBrake": {
   "label": [
    "Nihil Rail Brake (0.02–0.4)",
    "Nihil-Schiene Bremse (0,02–0,4)"
   ],
   "tip": [
    "Fixed braking per tick on top of 20%\nfriction, limited to 0.02-0.4. Default: 0.08.",
    "Feste Bremsung je Tick zusätzlich zu 20 %\nReibung, begrenzt auf 0,02-0,4. Standard: 0,08."
   ]
  }
 },
