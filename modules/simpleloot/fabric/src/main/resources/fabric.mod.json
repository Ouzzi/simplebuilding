{
  "schemaVersion": 1,
  "id": "simpleloot",
  "version": "${version}",
  "name": "Simple Loot",
  "icon": "assets/simpleloot/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Loot switch (server) and rain density (client); a sub-mod of Simple QoL, also playable alone.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleloot.LootFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleloot.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simpleloot.LootModMenu"
    ]
  },
  "depends": {
    "simplelib": ">=0.3.0",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "mixins": [
    "simpleloot.mixins.json"
  ],
  "suggests": {
    "simplequalityoflife": "*",
    "modmenu": "*"
  }
