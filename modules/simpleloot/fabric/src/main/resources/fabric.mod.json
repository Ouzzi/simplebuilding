{
  "schemaVersion": 1,
  "id": "simpleloot",
  "version": "${version}",
  "name": "Simple Loot",
  "icon": { "16": "assets/simpleloot/icon.png", "128": "assets/simpleloot/icon_128.png" },
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Vault cooldown in days instead of once per player; a sub-mod of Simple QoL, also playable alone.",
  "license": "LicenseRef-SimpleMods-ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleloot.LootFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleloot.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simpleloot.LootModMenu"
    ]
  },
  "depends": {
    "simplelib": ">=0.4.0-beta.1",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "simpleloot.mixins.json"
  ],
  "suggests": {
    "simplequalityoflife": "*",
    "modmenu": "*"
  },
  "custom": {
    "simplelib:content": []
  }
}
