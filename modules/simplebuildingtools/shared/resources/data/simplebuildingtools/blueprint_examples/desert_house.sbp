# Beispiel: kleines Wuestenhaus (Desert), 7 x 6 x 7, Flachdach
# Aufbau: Block, dann Positionen x,y,z; a..b ist ein Bereich, *n@dx,dy,dz wiederholt.

$rand = cut_sandstone
$zinne = smooth_sandstone_slab

# Fundament und Boden
smooth_sandstone 0..6,0,0..6

# Waende aus Sandstein, innen hohl
sandstone 0..6,1..3,0..6
air 1..5,1..3,1..5

# Kanten aus geschnittenem Sandstein
$rand 0,1..3,0 6,1..3,0 0,1..3,6 6,1..3,6

# Eingang: Wuestenhaeuser haben oft nur eine Oeffnung, hier mit Tuer
jungle_door 3,1,0
jungle_door[half=upper] 3,2,0

# Fensteroeffnungen (air) in beiden Seitenwaenden
air 0,2,2*2@0,0,2 6,2,2*2@0,0,2

# Flachdach mit Rand und Zinnen
smooth_sandstone 0..6,4,0..6
$zinne 0,5,0*4@2,0,0 0,5,6*4@2,0,0
$zinne 0,5,2*2@0,0,2 6,5,2*2@0,0,2

# Gelbe Terrakotta als Schmuckband ueber der Tuer
yellow_terracotta 2..4,3,0

# Innen: Fass und Heuballen
barrel[facing=up] 1,1,5
hay_block 5,1,5
