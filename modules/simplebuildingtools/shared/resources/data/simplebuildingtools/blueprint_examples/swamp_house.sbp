# Beispiel: kleines Sumpfhaus auf Stelzen (Swamp / Mangrove), 7 x 9 x 7
# Mangrovenholz, der Boden steht zwei Bloecke ueber dem Wasser.

$dach_s = mangrove_stairs[facing=south]
$dach_n = mangrove_stairs[facing=north]

# Stelzen aus Mangrovenstamm an den Ecken und in der Mitte der Laengsseiten
mangrove_log 0,0..1,0*2@6,0,0 0,0..1,6*2@6,0,0 0,0..1,3 6,0..1,3

# Boden auf den Stelzen
mangrove_planks 0..6,2,0..6

# Waende, innen hohl, Ecken aus Stamm
mangrove_planks 0..6,3..5,0..6
air 1..5,3..5,1..5
mangrove_log 0,3..5,0 6,3..5,0 0,3..5,6 6,3..5,6

# Tuer und Fenster
mangrove_door 3,3,0
mangrove_door[half=upper] 3,4,0
glass_pane[north=true,south=true] 0,4,3 6,4,3
glass_pane[east=true,west=true] 2,4,6*2@2,0,0

# Satteldach
$dach_s 0..6,6,0*3@0,1,1
$dach_n 0..6,6,6*3@0,1,-1
mangrove_planks 0..6,6,1..5 0..6,7,2..4
mangrove_slab 0..6,8,3

# Innen: Laterne und Kessel
lantern 5,3,5
cauldron 1,3,5
