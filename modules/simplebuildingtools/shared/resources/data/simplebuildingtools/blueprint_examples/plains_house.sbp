# Beispiel: kleines Dorfhaus der Ebene (Plains), 7 x 7 x 7
# Jede Zeile: ein Block, dann Positionen x,y,z (a..b = Bereich, beide Enden inklusive).
# Spaetere Zeilen ueberschreiben fruehere. Die Tuer zeigt nach Norden (z = 0).

# Aliase fuer lange Blockangaben
$dach_s = oak_stairs[facing=south]
$dach_n = oak_stairs[facing=north]

# Boden
cobblestone 0..6,0,0..6

# Waende: erst ein voller Kasten, dann innen mit air aushoehlen
oak_planks 0..6,1..3,0..6
air 1..5,1..3,1..5

# Eckpfosten aus Stamm
oak_log 0,1..3,0 6,1..3,0 0,1..3,6 6,1..3,6

# Tuer (untere und obere Haelfte) und Fenster
oak_door 3,1,0
oak_door[half=upper] 3,2,0
glass_pane[north=true,south=true] 0,2,3 6,2,3
glass_pane[east=true,west=true] 2,2,6*2@2,0,0   # zwei Fenster hinten, Abstand 2

# Satteldach: Treppen an den Traufen, Bretter darunter, Stufen als First
$dach_s 0..6,4,0 0..6,5,1 0..6,6,2
$dach_n 0..6,4,6 0..6,5,5 0..6,6,4
oak_planks 0..6,4,1..5 0..6,5,2..4
oak_slab 0..6,6,3

# Innen: Werkbank und eine Fackel an der Nordwand
crafting_table 1,1,5
wall_torch[facing=south] 3,3,1
