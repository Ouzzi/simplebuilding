{
  "schemaVersion": 1,
  "id": "simplemachines",
  "version": "${version}",
  "name": "Simple Machines",
  "icon": "assets/simplemachines/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "The machine parts of the Simple Machines tab: Double Piston (one block, two stages), Signal Dampener (takes 0-3 off the signal), and the piston upgrades - Reinforced (Sticky) Piston (pushes 18, one paid unbreakable), Netherite and Enderite Piston (break the block in front, with durability, repaired with their nugget). Works on its own; the Enderite Piston needs Simple Ores.",
  "license": "CC0-1.0",
  "environment": "*",
  "mixins": [
    "simplemachines.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplemachines.MachinesFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplemachines.ModuleGameTest"
    ],
    "client": [
      "com.simplebuilding.modules.simplemachines.MachinesFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.3.0"
  },
  "suggests": {
    "simplebuilding": "*",
    "simpleores": "*"
  }
}
