{
  "schemaVersion": 1,
  "id": "simpleslabs",
  "version": "${version}",
  "name": "Simple Slabs",
  "description": "Half slabs (4 pixels) of every block with a slab: stack them freely in the four layers of a cell, lean them against a wall as side half slab or side slab. Sand and gravel half slabs fall, grass takes the biome colour, copper ages.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "LicenseRef-SimpleMods-ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleslabs.SlabsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simpleslabs.SlabsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleslabs.ModuleGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.4.0-beta.1"
  },
  "icon": "assets/simpleslabs/icon.png",
  "suggests": {
    "simplebuilding": "*",
    "simpleblocks": "*",
    "simpleend": "*",
    "simpleores": "*",
    "simpleenchanting": "*",
    "jei": "*"
  }
}
