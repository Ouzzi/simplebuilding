{
  "schemaVersion": 1,
  "id": "simplefun",
  "version": "${version}",
  "name": "Simple Fun",
  "description": "Bounded playful mechanics, throwable bricks and cosmetic transformations (the animal heads moved to Simple Mobheads in 1.4.0).",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplefun.SimplefunFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplefun.ModuleGameTest"
    ],
    "client": [
      "com.simplefun.SimplefunFabricClient"
    ],
    "modmenu": [
      "com.simplefun.compat.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "com.simplefun.client.FunJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "mixins": [
    "simplefun.mixins.json",
    "simplefun.fabric.mixins.json"
  ],
  "suggests": {
    "modmenu": "*",
    "jei": "*",
    "jade": "*"
  }
}
