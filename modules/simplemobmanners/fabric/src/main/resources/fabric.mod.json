{
  "schemaVersion": 1,
  "id": "simplemobmanners",
  "version": "${version}",
  "name": "Simple Mob Manners",
  "icon": { "16": "assets/simplemobmanners/icon.png", "128": "assets/simplemobmanners/icon_128.png" },
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
