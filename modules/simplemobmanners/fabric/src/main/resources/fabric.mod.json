      "com.simplebuilding.modules.simplemobmanners.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simplemobmanners.MobMannersModMenu"
    ]
  },
  "depends": {
    "simplelib": ">=0.4.0-beta.1",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "simplemobmanners.mixins.json"
  ],
  "suggests": {
    "simplequalityoflife": "*",
    "modmenu": "*"
