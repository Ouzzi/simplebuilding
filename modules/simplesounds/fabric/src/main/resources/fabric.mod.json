{
  "schemaVersion": 1,
  "id": "simplesounds",
  "version": "${version}",
  "name": "Simple Sounds",
  "description": "Bounded local Vanilla sound counterparts for the twelve Simple Visuals immersion effects.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplesounds.SoundsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplesounds.SoundsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplesounds.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simplesounds.SoundsModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
