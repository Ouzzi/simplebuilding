{
  "schemaVersion": 1,
  "id": "simplemodels",
  "version": "${version}",
  "name": "Simple Models",
  "description": "Server-approved custom item models, anvil assignment, and a searchable model browser.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplemodels.ModelsFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplemodels.ModuleGameTest"
    ],
    "client": [
      "com.simplebuilding.modules.simplemodels.FabricModelsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "simplemodels.mixins.json"
  ],
  "provides": [
    "renamed"
  ],
  "suggests": {
    "simplebuilding": "*",
    "modmenu": "*"
  }
}
