{
  "schemaVersion": 1,
  "id": "simpleblocks",
  "version": "${version}",
  "name": "Simple Blocks",
  "icon": "assets/simpleblocks/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Missing building blocks: Hushed Deepslate Tiles that dampen vibrations like wool, Sculk Deepslate, the missing Vanilla stairs, slabs and walls and cracked/mossy brick variants. The Shapecutter cuts stone and wood into every stair, slab and shape. Works on its own with Vanilla.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleblocks.BlocksFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simpleblocks.BlocksFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleblocks.ModuleGameTest"
    ],
    "jei_mod_plugin": [
      "com.simpleblocks.compat.jei.BlocksJeiPlugin"
    ]
  },
  "mixins": [
    "simpleblocks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.2.0"
  },
  "suggests": {
    "simplebuilding": "*",
    "jei": "*"
  }
}
