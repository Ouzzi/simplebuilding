  "text.autoconfig.simpleblocks.option.snowlogging.@Tooltip": "A snow layer used on a fence, flower or\ngrass shares the block with it. Default:\ntrue. Server setting.",
  "text.autoconfig.simpleblocks.option.snowCaps": "Snow Caps",
  "text.autoconfig.simpleblocks.option.snowCaps.@Tooltip": "Falling snow leaves one snow layer on top of\nfences, walls, stairs and slabs. Default: true.\nServer setting.",
  "text.autoconfig.simpleblocks.option.frostGrass": "Frost Grass",
  "text.autoconfig.simpleblocks.option.frostGrass.@Tooltip": "Grass under snow freezes to frost grass in\ncold biomes or above ice. Default: true.\nServer setting.",
