{
  "multipart": [
    {
      "when": {
        "inner": "false"
      },
      "apply": {
        "model": "simpleend:block/ashwood_leaves"
      }
    },
    {
      "when": {
        "inner": "true"
      },
      "apply": {
        "model": "simpleend:block/ashwood_leaves_inner"
      }
    },
    {
      "when": {
        "OR": [
          {
            "drop": "1"
          },
          {
            "drop": "2"
          }
        ]
      },
      "apply": {
        "model": "simpleend:block/ashwood_leaves_crystal"
      }
    }
  ]
}
