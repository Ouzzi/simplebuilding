{
  "multipart": [
    {
      "when": {
        "density": "0"
      },
      "apply": {
        "model": "simpleend:block/duskwood_leaves_loose"
      }
    },
    {
      "when": {
        "density": "1"
      },
      "apply": {
        "model": "simpleend:block/duskwood_leaves"
      }
    },
    {
      "when": {
        "density": "2"
      },
      "apply": {
        "model": "simpleend:block/duskwood_leaves_inner"
      }
    },
    {
      "when": {
        "OR": [
          {
            "drop": "1"
          },
          {
            "drop": "2"
          }
        ]
      },
      "apply": {
        "model": "simpleend:block/duskwood_leaves_crystal"
      }
    }
  ]
}
