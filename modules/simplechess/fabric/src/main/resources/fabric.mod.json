{
  "schemaVersion": 1,
  "id": "simplechess",
  "version": "${version}",
  "name": "Simple Chess",
  "description": "Chess: 156 pieces (13 colors, six kinds, 3D and flat) that stand up to four on a block, 12 quartz checker boards with stairs and slabs and, with Simple Octets, the chess octets - moved from SimpleBuilding (ids migrate).",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "LicenseRef-SimpleMods-ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplechess.ChessFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplechess.ChessFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplechess.ModuleGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.4.0-beta.1"
  },
  "icon": "assets/simplechess/icon.png",
  "suggests": {
    "simplebuilding": "*",
    "simpleoctets": "*"
  }
}
