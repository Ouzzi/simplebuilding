{
  "schemaVersion": 1,
  "id": "simplemobs",
  "version": "${version}",
  "name": "Simple Mobs",
  "icon": "assets/simplemobs/icon.png",
  "description": "Hollow Howler and Hollow Watcher bosses, Shellker, Soulfire Blaze, Dread and Deceiver mobs, Blighted and Abyssal Wither with Nether Heart and Red Nether Gem, and the Potion of Silence.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplemobs.MobsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplemobs.FabricClientExample"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplemobs.ModuleGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "simplelib": ">=0.2.0"
  },
  "mixins": [
    "simplemobs.mixins.json"
  ]
}
