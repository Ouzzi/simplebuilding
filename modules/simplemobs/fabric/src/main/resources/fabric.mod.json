{
  "schemaVersion": 1,
  "id": "simplemobs",
  "version": "${version}",
  "name": "Simple Mobs",
  "description": "Hollow Howler and Hollow Watcher bosses, Shellker, Soulfire Blaze, Dread and Deceiver mobs, Blighted Wither, Potion of Silence and the Biome Brush.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplemobs.MobsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplemobs.FabricClientExample"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplemobs.ModuleGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "mixins": [
    "simplemobs.mixins.json"
  ]
