{
  "schemaVersion": 1,
  "id": "simplemovement",
  "version": "${version}",
  "name": "Simple Movement",
  "icon": "assets/simplemovement/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Manual crawling, server-allowed autowalk, faster ladders and Frost Walker on powder snow; a sub-mod of Simple QoL, also playable alone.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplemovement.MovementFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplemovement.ModuleGameTest"
    ],
    "client": [
      "com.simplebuilding.modules.simplemovement.MovementFabricClient"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simplemovement.MovementModMenu"
    ]
  },
  "depends": {
    "simplelib": ">=0.3.0",
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "mixins": [
    "simplemovement.mixins.json"
  ],
  "suggests": {
    "simplequalityoflife": "*",
    "modmenu": "*"
  }
}
