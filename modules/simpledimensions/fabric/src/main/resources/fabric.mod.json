{
  "schemaVersion": 1,
  "id": "simpledimension",
  "version": "${version}",
  "name": "Simple Dimensions",
  "description": "Configurable dimensions, light arches, and safe linked portals.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpledimensions.DimensionsFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpledimensions.ModuleGameTest"
    ],
    "client": [
      "com.simplebuilding.modules.simpledimensions.DimensionClient"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simpledimensions.DimensionModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*"
  },
  "mixins": [
    "simpledimension.mixins.json"
  ],
  "suggests": {
    "simplebuilding": "*",
    "modmenu": "*",
    "flan": "*",
    "ftbchunks": "*",
    "openpartiesandclaims": "*",
    "griefdefender": "*",
    "claimchunk": "*"
  }
}
