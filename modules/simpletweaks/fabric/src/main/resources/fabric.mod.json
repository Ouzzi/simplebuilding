{
  "schemaVersion": 1,
  "id": "simpletweaks",
  "version": "${version}",
  "name": "Simple Tweaks",
  "description": "Legacy compatibility and server-authoritative claims, on by default.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpletweaks.TweaksFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simpletweaks.TweaksFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpletweaks.ModuleGameTest",
      "com.simplebuilding.modules.simpletweaks.ClaimsGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.2.0"
  },
  "mixins": [
    "simpletweaks.mixins.json",
    "simpletweaks.claims.mixins.json"
  ],
  "license": "CC0-1.0",
  "suggests": {
    "simpledimension": "*",
    "simplebuilding": "*"
  }
}
