{
  "schemaVersion": 1,
  "id": "simpleinterfaces",
  "version": "${version}",
  "name": "Simple Interfaces",
  "icon": "assets/simpleinterfaces/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Restyle of the Vanilla container screens (a coloured box per block, drawn in code), linked containers and Easy Shulkers / Ender Chests; a sub-mod of Simple QoL, also playable alone.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleinterfaces.InterfacesFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleinterfaces.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simpleinterfaces.ContainersModMenu"
    ],
    "client": [
      "com.simplebuilding.modules.simpleinterfaces.ContainersFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*",
    "simplelib": ">=0.3.0"
  },
  "mixins": [
    "simpleinterfaces.mixins.json"
  ],
  "suggests": {
    "simplebuilding": "*",
    "modmenu": "*"
  }
}
