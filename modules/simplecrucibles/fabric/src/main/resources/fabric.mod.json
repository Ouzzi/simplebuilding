{
  "schemaVersion": 1,
  "id": "simplecrucibles",
  "version": "${version}",
  "name": "Simple Crucibles",
  "description": "Iron, Reinforced, Netherite and Enderite crucibles and barrels (a cooking station without fuel), the reinforced cauldron and village field kitchens, moved from SimpleLib and SimpleBuilding (ids migrate). Upgrades in the world with the axe on its own, with the sledgehammer in SimpleBuilding.",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplecrucibles.CruciblesFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simplecrucibles.CruciblesFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplecrucibles.ModuleGameTest"
    ],
    "jei_mod_plugin": [
      "com.simplecrucibles.compat.jei.CruciblesJeiPlugin"
    ],
    "jade": [
      "com.simplecrucibles.compat.jade.CruciblesJadePlugin"
    ]
  },
  "mixins": [
    "simplecrucibles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.2.0"
  },
  "suggests": {
    "simplebuilding": "*",
    "jei": "*",
    "jade": "*"
  }
}
