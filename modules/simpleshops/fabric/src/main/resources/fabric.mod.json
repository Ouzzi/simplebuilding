{
  "schemaVersion": 1,
  "id": "simpleshops",
  "version": "${version}",
  "name": "Simple Shops",
  "icon": "assets/simpleshops/icon.png",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "description": "Player shops: a Sales Block with a price (up to five exact price items) and a Display Case with up to five goods, one piece per trade; Sales Storage, Trade Terminal and shop music. Protected from strangers, explosions, pistons and hoppers; no claim right needed to buy.",
  "license": "LicenseRef-SimpleMods-ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleshops.ShopsFabric"
    ],
    "client": [
      "com.simplebuilding.modules.simpleshops.ShopsFabricClient"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleshops.ModuleGameTest"
    ]
  },
  "mixins": [
    "simpleshops.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "simplelib": ">=0.4.0"
  },
  "suggests": {
    "simplebuilding": "*",
    "simplemoney": "*",
    "simpletweaks": "*"
  }
}
