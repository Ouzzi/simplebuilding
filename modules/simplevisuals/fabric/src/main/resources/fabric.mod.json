{
  "schemaVersion": 1,
  "id": "simplevisuals",
  "version": "${version}",
  "name": "Simple Visuals",
  "description": "Bounded client HUD, tooltips, anvil formatting, and Vanilla immersion particles.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://azarfane.de/",
    "sources": "https://github.com/Ouzzi/simplebuilding",
    "issues": "https://github.com/Ouzzi/simplebuilding/issues"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simplevisuals.VisualsFabric"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simplevisuals.ModuleGameTest"
    ],
    "modmenu": [
      "com.simplevisuals.fabric.VisualsModMenu"
    ],
    "client": [
      "com.simplevisuals.fabric.VisualsFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*"
  },
  "mixins": [
    "simplevisuals.mixins.json"
  ],
  "icon": "assets/simplevisuals/icon.png",
  "suggests": {
    "simplebuilding": "*",
    "simplemodels": "*",
    "modmenu": "*"
  }
}
