{
  "schemaVersion": 1,
  "id": "simpleriding",
  "version": "${version}",
  "name": "Simple Riding",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplebuilding.modules.simpleriding.FabricExample"
    ],
    "modmenu": [
      "com.simplebuilding.modules.simpleriding.RidingModMenu"
    ],
    "fabric-gametest": [
      "com.simplebuilding.modules.simpleriding.RidingGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3"
  },
  "mixins": [
    "simpleriding.mixins.json",
    "simpleriding.fabric.mixins.json"
  ],
  "description": "Custom saddle and horse armor enchantments: Tailwind for mount speed, Leaping for jump height, plus protective enchantments on horse armor.",
  "authors": [
    "Ouzzi"
  ],
  "contact": {
    "homepage": "https://github.com/Ouzzi/simpleriding",
    "sources": "https://github.com/Ouzzi/simpleriding",
    "issues": "https://github.com/Ouzzi/simpleriding/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/simpleriding/icon.png",
  "suggests": {
    "simplebuilding": "*",
    "modmenu": "*"
  }
}
