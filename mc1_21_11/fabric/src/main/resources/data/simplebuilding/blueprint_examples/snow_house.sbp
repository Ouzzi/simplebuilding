# Beispiel: kleines Schneedorf-Haus (Snowy), 7 x 7 x 7
# Steinziegel-Sockel, Fichtenholz mit entrindeten Pfosten, Schnee auf dem Dach.

$dach_s = spruce_stairs[facing=south]
$dach_n = spruce_stairs[facing=north]
$pfosten = stripped_spruce_log

# Sockel und Boden
stone_bricks 0..6,0,0..6

# Waende aus weisser Terrakotta, innen hohl
white_terracotta 0..6,1..3,0..6
air 1..5,1..3,1..5
$pfosten 0,1..3,0 6,1..3,0 0,1..3,6 6,1..3,6

# Tuer und Fenster
spruce_door 3,1,0
spruce_door[half=upper] 3,2,0
glass_pane[north=true,south=true] 0,2,3 6,2,3
glass_pane[east=true,west=true] 2,2,6*2@2,0,0

# Satteldach mit Schneedecke auf dem First
$dach_s 0..6,4,0*3@0,1,1
$dach_n 0..6,4,6*3@0,1,-1
spruce_planks 0..6,4,1..5 0..6,5,2..4
snow_block 0..6,6,3

# Innen: Laterne, Bett (Fussende und Kopfteil)
lantern 1,1,1
red_bed[facing=east] 4,1,5
red_bed[facing=east,part=head] 5,1,5
