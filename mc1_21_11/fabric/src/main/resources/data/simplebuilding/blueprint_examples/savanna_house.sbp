# Beispiel: kleines Savannenhaus (Savanna), 7 x 7 x 7
# Akazienholz, Terrakotta-Sockel, flaches Walmdach mit Treppen.

$dach_s = acacia_stairs[facing=south]
$dach_n = acacia_stairs[facing=north]
$dach_w = acacia_stairs[facing=west]
$dach_o = acacia_stairs[facing=east]

# Sockel aus Terrakotta, Boden aus Akazienbrettern
terracotta 0..6,0,0..6
acacia_planks 1..5,0,1..5

# Waende: Bretter, innen hohl, Ecken aus Akazienstamm
acacia_planks 0..6,1..3,0..6
air 1..5,1..3,1..5
acacia_log 0,1..3,0 6,1..3,0 0,1..3,6 6,1..3,6

# Tuer und Fenster
acacia_door 3,1,0
acacia_door[half=upper] 3,2,0
glass_pane[north=true,south=true] 0,2,2*2@0,0,2 6,2,2*2@0,0,2

# Dach: umlaufende Treppen, darueber Bretter, oben ein Zaun als Spitze
$dach_s 1..5,4,0
$dach_n 1..5,4,6
$dach_o 0,4,0..6
$dach_w 6,4,0..6
acacia_planks 1..5,4,1..5
$dach_s 2..4,5,1
$dach_n 2..4,5,5
$dach_o 1,5,1..5
$dach_w 5,5,1..5
acacia_planks 2..4,5,2..4
acacia_slab 3,6,3

# Innen: Zaun mit Druckplatte als Tisch, Fackel und Truhe
acacia_fence 1,1,5
acacia_pressure_plate 1,2,5
wall_torch[facing=south] 3,3,1
chest[facing=south] 5,1,5
