# proxy settings of smweb (@STAGE@): the service trusts X-Client-IP only from loopback (nginx on the same machine)
proxy_pass http://smweb_@STAGE@;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Client-IP $sb_client_ip;
proxy_set_header X-Forwarded-For "";
proxy_read_timeout 60s;
proxy_request_buffering on;
