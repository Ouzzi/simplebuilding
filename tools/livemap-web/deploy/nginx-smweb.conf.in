# Simple Mods account + hosted Simple Livemap (@STAGE@), rendered by deploy_livemap_web.sh from tools/livemap-web/deploy.
# Same listen ports and allow snippet as the simplemods site (tunnel connector + loopback only). $sb_client_ip comes from the
# site's common.conf (CF-Connecting-IP). Access log without query strings, rotated after 7 days (logrotate file of the deploy).
limit_req_zone $sb_client_ip zone=smweb_auth_@STAGE@:1m rate=10r/m;
limit_req_zone $sb_client_ip zone=smweb_web_@STAGE@:5m rate=20r/s;
limit_req_zone $sb_client_ip zone=smweb_api_@STAGE@:5m rate=10r/s;
log_format smweb_@STAGE@ '$sb_client_ip [$time_local] "$request_method $uri" $status $body_bytes_sent';

upstream smweb_@STAGE@ { server 127.0.0.1:@PORT@; keepalive 8; }

server { listen 8081; listen 8084; server_name @ACCOUNT_HOST@;
  include /etc/nginx/snippets/simplemods-allow.conf;
  access_log /var/log/nginx/smweb-@STAGE@.access.log smweb_@STAGE@;
  client_max_body_size 64k;
  @DEV_AUTH@
  location ~ ^/(login|register|forgot|reset|resend)$ { limit_req zone=smweb_auth_@STAGE@ burst=5 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; }
  location / { limit_req zone=smweb_web_@STAGE@ burst=40 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; } }

server { listen 8081; listen 8084; server_name @LIVEMAP_HOST@;
  include /etc/nginx/snippets/simplemods-allow.conf;
  access_log /var/log/nginx/smweb-@STAGE@.access.log smweb_@STAGE@;
  client_max_body_size 64k;
  # the mod's upload API has its own key; it stays reachable for game servers also on the dev stage
  location = /api/v1/tiles { client_max_body_size 9m; limit_req zone=smweb_api_@STAGE@ burst=20 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; }
  location ^~ /api/v1/ { limit_req zone=smweb_api_@STAGE@ burst=20 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; }
  location = /api/stripe/webhook { client_max_body_size 256k; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; }
  location ^~ /m/ { @DEV_AUTH@ limit_req zone=smweb_web_@STAGE@ burst=200 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; }
  location / { @DEV_AUTH@ limit_req zone=smweb_web_@STAGE@ burst=40 nodelay; limit_req_status 429; include /etc/nginx/snippets/smweb-proxy-@STAGE@.conf; } }
