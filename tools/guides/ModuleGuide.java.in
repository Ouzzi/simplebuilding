package @PACKAGE@;

import com.simplebuilding.framework.api.ModuleQuestDefaults;
import java.io.IOException;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import net.minecraft.ChatFormatting;
import net.minecraft.core.Registry;
import net.minecraft.core.component.DataComponents;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.core.registries.Registries;
import net.minecraft.gametest.framework.GameTestHelper;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.Identifier;
import net.minecraft.resources.ResourceKey;
import net.minecraft.server.network.Filterable;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.item.WrittenBookItem;
import net.minecraft.world.item.component.WrittenBookContent;
import net.minecraft.world.item.crafting.CraftingInput;
import net.minecraft.world.item.crafting.RecipeType;

/**
 * The @AUTHOR@ guide book - GENERATED by tools/guides/module_guides.py from tools/guides/ModuleGuide.java.in, do not
 * edit (plan: docs/ai/PLAN-MODUL-GUIDES-2026-10-05.md).
 *
 * <p>A Vanilla {@link WrittenBookItem} whose default {@code written_book_content} holds {@link #PAGES} translatable
 * pages ({@code @NAMESPACE@.guide.page.<n>} and {@code .title}); Vanilla opens it on use in the reader's language.
 * The content is marked resolved, so opening never copies the pages into the stack and updated texts reach old
 * books. Crafted shapeless from a book and {@link #RECIPE_ITEM}; no SimpleBuilding needed. With FTB Quests installed,
 * {@link #installQuests} copies a start chapter whose first quest gives the book.
 */
public final class @CLASS@ {
    public static final String NAMESPACE = "@NAMESPACE@";
    public static final String AUTHOR = "@AUTHOR@";
    public static final int PAGES = @PAGES@;
    public static final Identifier ID = Identifier.fromNamespaceAndPath(NAMESPACE, "guide_book");
    /** The Vanilla item that, together with a book, crafts the guide. */
    public static final Item RECIPE_ITEM = Items.@RECIPE_ITEM@;
    private static Item book;

    private @CLASS@() {
    }

    /** Registers the book once; call from the loader's item registration. */
    public static Item register() {
        if (book == null) {
            Item.Properties properties = new Item.Properties().setId(ResourceKey.create(Registries.ITEM, ID)).stacksTo(1)
                    .component(DataComponents.WRITTEN_BOOK_CONTENT, content());
            book = Registry.register(BuiltInRegistries.ITEM, ID, new WrittenBookItem(properties));
        }
        return book;
    }

    /** The registered book; {@code null} before {@link #register}. */
    public static Item book() {
        return book;
    }

    public static ItemStack stack() {
        return new ItemStack(book);
    }

    public static Component page(int number) {
        String key = NAMESPACE + ".guide.page." + number;
        return Component.empty().append(Component.translatable(key + ".title").withStyle(ChatFormatting.BOLD))
                .append("\n\n").append(Component.translatable(key));
    }

    public static List<Component> pages() {
        List<Component> pages = new ArrayList<>();
        for (int i = 1; i <= PAGES; i++) {
            pages.add(page(i));
        }
        return pages;
    }

    public static WrittenBookContent content() {
        return new WrittenBookContent(Filterable.passThrough(""), AUTHOR, 0,
                pages().stream().map(Filterable::passThrough).toList(), true);
    }

    /**
     * Copies the start chapter into {@code <configDir>/ftbquests/quests}; call only when FTB Quests is loaded.
     * Returns the number of files written, or -1 on failure (logged by the caller's choice, never thrown).
     */
    public static int installQuests(Path configDir) {
        try {
            return ModuleQuestDefaults.install(configDir.resolve("ftbquests").resolve("quests"), NAMESPACE, @CLASS@::questResource);
        } catch (IOException | RuntimeException e) {
            return -1;
        }
    }

    static String questResource(String relative) {
        return resource("/data/" + NAMESPACE + "/ftbquests/" + relative);
    }

    static String resource(String path) {
        try (InputStream in = @CLASS@.class.getResourceAsStream(path)) {
            return in == null ? null : new String(in.readAllBytes(), StandardCharsets.UTF_8);
        } catch (IOException e) {
            return null;
        }
    }

    /** GameTest: the book is registered, craftable from Vanilla items, has its pages and opens without copying them. */
    public static void gameTest(GameTestHelper h) {
        Item registered = BuiltInRegistries.ITEM.getValue(ID);
        h.assertTrue(registered instanceof WrittenBookItem && registered == book, "guide book not registered: " + ID);
        CraftingInput input = CraftingInput.of(2, 1, List.of(new ItemStack(Items.BOOK), new ItemStack(RECIPE_ITEM)));
        ItemStack crafted = h.getLevel().getServer().getRecipeManager().getRecipeFor(RecipeType.CRAFTING, input, h.getLevel())
                .map(recipe -> recipe.value().assemble(input)).orElse(ItemStack.EMPTY);
        h.assertTrue(crafted.is(book), "book + " + BuiltInRegistries.ITEM.getKey(RECIPE_ITEM) + " does not craft " + ID);
        WrittenBookContent content = crafted.get(DataComponents.WRITTEN_BOOK_CONTENT);
        h.assertTrue(content != null && content.pages().size() == PAGES && PAGES > 1, "guide has not " + PAGES + " pages");
        var player = h.makeMockServerPlayerInLevel();
        h.runBeforeTestEnd(() -> h.getLevel().getServer().getPlayerList().remove(player));
        player.setItemInHand(InteractionHand.MAIN_HAND, crafted);
        h.assertTrue(crafted.use(h.getLevel(), player, InteractionHand.MAIN_HAND).consumesAction(), "guide does not open");
        h.assertTrue(crafted.getComponentsPatch().isEmpty(), "opening copied the pages into the stack");
        h.assertTrue(questResource("install.txt") != null && questResource("chapters/" + NAMESPACE + "_start.json5") != null,
                "FTB Quests start chapter missing");
        for (String locale : List.of("en_us", "de_de")) {
            String lang = resource("/assets/" + NAMESPACE + "/lang/" + locale + ".json");
            h.assertTrue(lang != null && lang.contains("\"" + NAMESPACE + ".guide.page." + PAGES + ".title\"")
                    && !lang.contains("\"" + NAMESPACE + ".guide.page." + (PAGES + 1) + ".title\""), locale + " lacks the guide pages");
        }
        h.succeed();
    }
}
