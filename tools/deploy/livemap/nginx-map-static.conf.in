# Simple Livemap under /map/ on wiki.simplemods.de (N14b, variant B: static copy) – server context, installed as
# /etc/nginx/snippets/simplemods-livemap.conf. Files come from livemap-sync.sh (tiles + live.json + index.html).
# Rendered by tools/deploy/livemap/deploy_livemap.sh (@INFO@); edit the template in the repo, not this file.
location = /map { return 301 /map/; }
location ^~ /map/ {
  @AUTH@
  limit_req zone=sb_livemap burst=80 nodelay; limit_req_status 429;
  limit_except GET { deny all; }
  alias @STATIC_DIR@/; index index.html;
  log_not_found off;
  # same headers the mod's own server sends
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
  add_header Cache-Control "no-cache" always;
  location ~ /\. { deny all; }
  location ^~ /map/tiles/ {
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "@TILE_CC@" always; }
}
