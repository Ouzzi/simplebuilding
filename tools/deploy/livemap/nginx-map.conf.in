# Simple Livemap under /map/ on wiki.simplemods.de (N14b) – server context, installed as
# /etc/nginx/snippets/simplemods-livemap.conf and included from the wiki server block.
# Rendered by tools/deploy/livemap/deploy_livemap.sh (@INFO@); edit the template in the repo, not this file.
# The viewer uses relative paths (tiles/..., live.json), so it works under /map/ unchanged. Read only: GET/HEAD.
# No websocket/SSE today (the viewer polls). A later SSE route would need its own location with proxy_buffering off.
location = /map { return 301 /map/; }
location ^~ /map/ {
  @AUTH@
  limit_req zone=sb_livemap burst=80 nodelay; limit_req_status 429;
  limit_except GET { deny all; }
  client_max_body_size 1k;
  proxy_http_version 1.1;
  proxy_connect_timeout 3s; proxy_send_timeout 5s; proxy_read_timeout 10s;
  # Only here (nested locations set none): nginx drops inherited proxy_set_header lines as soon as a level sets one.
  proxy_set_header Host $proxy_host;
  proxy_set_header Connection "";
  proxy_set_header Cookie "";            # the wiki session never reaches the game server
  proxy_set_header X-Client-IP "";
  proxy_set_header Cf-Access-Authenticated-User-Email "";
  @TOKEN@
  proxy_hide_header Cache-Control;
  proxy_hide_header Set-Cookie;
  @CACHE@

  # the three routes of the mod; anything else never reaches the game server
  location = /map/ {
    proxy_pass http://simplemods_livemap/;
    @CACHE_PAGE@
    add_header Cache-Control "no-cache" always; add_header X-Cache $upstream_cache_status always; }
  location = /map/live.json {
    proxy_pass http://simplemods_livemap/live.json;
    @CACHE_LIVE@
    add_header Cache-Control "no-store" always; add_header X-Cache $upstream_cache_status always; }
  location ~ "^/map/tiles/[a-z0-9_.-]{1,96}/[0-4]/-?[0-9]{1,7}/-?[0-9]{1,7}\.png$" {
    rewrite ^/map(/.*)$ $1 break;
    proxy_pass http://simplemods_livemap;
    @CACHE_TILES@
    add_header Cache-Control "@TILE_CC@" always; add_header X-Cache $upstream_cache_status always; }
  location = /map/index.html { return 301 /map/; }
  return 404;
}
