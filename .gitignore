# Datagen cache (regenerated by runDatagen, never committed)
src/main/generated/.cache/
**/src/main/generated/.cache/

# Client gametest run directory
build/run/

# Vanilla-Texturen, die wiki/generate.py aus dem Minecraft-Client-Jar zieht.
# Mojang-Assets gehoeren nicht ins Repository; ein Generatorlauf holt sie lokal.
wiki/assets/textures/minecraft/

# Aufzeichnungen der Testlaeufe (tools/testrunner/run.py). Die Oberflaeche
# testing/index.html gehoert ins Repo, die Laufdaten nicht: sie entstehen bei
# jedem Lauf neu und wuerden jeden Commit mit Rauschen fuellen.
testing/runs/
testing/data/

# Balancing-Zentrale (tools/devserver): balance/balance.json und balance/versions/ gehoeren ins
# Repo, die Sperrdatei und abgebrochene Schreibvorgaenge nicht.
balance/.lock
balance/**/.*.tmp

# Python-Bytecode der Werkzeuge unter tools/
__pycache__/
*.pyc

# Arbeitsdateien der Werkzeugkette (Lueckenlisten, Zwischenstaende). .claude/launch.json
# ist versioniert, der Rest nicht.
.claude/tmp/
.claude/worktrees/
.claude/settings.local.json
# Forge-Spieltestwelt (forge/build.gradle, Run gameTestServer)
run-gametest/
scratchpad/

# Lokale Laufdateien eines Clients/Servers im Repo-Wurzelverzeichnis (Audit 2026-09-26 #45)
/_catchup.patch
/imgui.ini
/options.txt
/downloads/
/logs/
