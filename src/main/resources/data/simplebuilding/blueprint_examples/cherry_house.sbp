# Beispiel: kleines Kirschhain-Haus (Cherry Grove), 7 x 7 x 7
# Kirschholz, Steinsockel, Dach mit umgedrehter Traufe.

$dach_s = cherry_stairs[facing=south]
$dach_n = cherry_stairs[facing=north]
$traufe_s = cherry_stairs[facing=south,half=top]
$traufe_n = cherry_stairs[facing=north,half=top]

# Sockel aus bemoosten Steinziegeln, Boden aus Kirschbrettern
mossy_stone_bricks 0..6,0,0..6
cherry_planks 1..5,0,1..5

# Waende, innen hohl, Ecken aus Kirschstamm
cherry_planks 0..6,1..3,0..6
air 1..5,1..3,1..5
cherry_log 0,1..3,0 6,1..3,0 0,1..3,6 6,1..3,6

# Tuer und Fenster
cherry_door 3,1,0
cherry_door[half=upper] 3,2,0
glass_pane[north=true,south=true] 0,2,2*2@0,0,2 6,2,2*2@0,0,2

# Dach: umgedrehte Treppen als Traufe, darueber drei Treppenreihen je Seite
$traufe_s 0..6,3,0
$traufe_n 0..6,3,6
$dach_s 0..6,4,0*3@0,1,1
$dach_n 0..6,4,6*3@0,1,-1
cherry_planks 0..6,4,1..5 0..6,5,2..4
cherry_slab 0..6,6,3

# Innen: Laterne und Buecherregal
lantern[hanging=true] 3,3,3
bookshelf 1,1,5*3@1,0,0
