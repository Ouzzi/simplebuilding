{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wiki",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "wiki"
      ],
      "port": 8765
    },
    {
      "name": "balancing-zentrale",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "tools/devserver/serve.py",
        "--no-browser",
        "--port",
        "8770"
      ],
      "port": 8770
    },
    {
      "name": "launchhub",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "tools/launchhub/server.py",
        "--no-browser",
        "--port",
        "8771"
      ],
      "port": 8771
    }
  ]
}
